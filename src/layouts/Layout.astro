---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/figtree";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const { title, description = "Websites für kleine Betriebe in Vorarlberg. Festpreis ab 490 €, online in 2 bis 4 Wochen." } = Astro.props;
---
<html lang="de" class="scroll-smooth scroll-pt-16">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon-kupfer.svg" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="bg-cream text-ink font-sans antialiased">
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>