---
import LogoAnimiert from "./LogoAnimiert.astro";

const links = [
  { href: "/#angebot", label: "Preise" },
  { href: "/#ablauf", label: "Ablauf" },
  { href: "/#kontakt", label: "Kontakt" },
];
---
<header class="sticky [@media(max-height:30rem)]:static top-0 z-50 bg-cream/90 backdrop-blur border-b border-ink/10">
  <nav class="max-w-page mx-auto flex items-center justify-between px-6 lg:px-10 py-3" aria-label="Hauptnavigation">
    <a href="/" class="flex items-center">
      <LogoAnimiert />
    </a>

    <ul class="hidden sm:flex gap-6 text-sm font-medium">
      {links.map((l) => (
        <li><a href={l.href} class="nav-link">{l.label}</a></li>
      ))}
    </ul>

    <button
      id="menu-toggle"
      type="button"
      class="group sm:hidden -mr-2 grid h-10 w-10 place-items-center rounded-full text-ink hover:bg-ink/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menü öffnen"
    >
      <svg class="h-6 w-6 group-aria-expanded:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg class="hidden h-6 w-6 group-aria-expanded:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="sm:hidden max-h-[calc(100dvh-4rem)] overflow-y-auto" hidden>
    <ul class="max-w-page mx-auto px-6 lg:px-10 pb-4 text-base font-medium">
      {links.map((l) => (
        <li><a href={l.href} class="block py-3 border-t border-ink/10 hover:text-primary transition-colors">{l.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle") as HTMLButtonElement;
  const menu = document.getElementById("mobile-menu") as HTMLElement;

  function setOpen(open: boolean) {
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Menü schließen" : "Menü öffnen");
    menu.hidden = !open;
  }

  toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));

  // Nach Klick auf einen Anker-Link schließen, damit das Ziel sichtbar ist
  menu.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !menu.hidden) {
      setOpen(false);
      toggle.focus();
    }
  });

  // Beim Drehen/Vergrößern auf Desktop-Breite nicht offen hängen bleiben
  matchMedia("(min-width: 40rem)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });
</script>
