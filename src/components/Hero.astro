---
import { Image } from "astro:assets";
import Pfeil from "./Pfeil.astro";
import muster from "../assets/hero-muster-orange.png";

const vorteile = [
  "Festpreis ab 490 €",
  "Online in 2 bis 4 Wochen",
  "Eine Ansprechperson in Vorarlberg",
];
---
<section class="relative overflow-hidden bg-cream">
  <!-- Muster: helle Höhenlinien, das warme Leuchten sitzt rechts hinter dem Mockup -->
  <Image
    src={muster}
    alt=""
    widths={[800, 1200, 1800, 2400]}
    sizes="100vw"
    format="avif"
    loading="eager"
    fetchpriority="high"
    class="pointer-events-none absolute inset-0 h-full w-full object-cover object-[75%_50%] md:object-right"
  />

  <div class="relative max-w-page mx-auto px-6 lg:px-10 pt-16 pb-20 md:pt-24 md:pb-28 grid gap-14 md:grid-cols-[1.05fr_1fr] items-center">

    <div>
      <h1 class="titel-einschweben font-display text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-tight text-ink">
        Ihre Kunden suchen zuerst im Internet. Dort sollten sie Sie finden.
      </h1>
      <p class="intro-text [--verzoegerung:160ms] mt-6 text-lg text-ink/80 max-w-[38rem] leading-relaxed">
        Sie erzählen mir, was Ihren Betrieb ausmacht. Um Gestaltung, Technik
        und Einrichtung kümmere ich mich.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#kontakt" class="btn btn-primary">
          Erstgespräch anfragen
          <Pfeil />
        </a>
        <a href="#angebot" class="btn btn-secondary">
          Preise ansehen
        </a>
      </div>

      <ul class="mt-10 space-y-2 text-ink">
        {vorteile.map((v) => (
          <li class="flex items-center gap-3">
            <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
            {v}
          </li>
        ))}
      </ul>
    </div>


    <!-- Browser-Mockup einer Beispiel-Kundenseite -->
    <div class="group relative" aria-hidden="true">
      <div class="intro-stapel-unten absolute -inset-4 2xl:-inset-10 rounded-[2.5rem] bg-primary/[0.06]"></div>

      <div class="intro-stapel-oben relative rounded-2xl border border-black/10 bg-white shadow-[0_30px_60px_-20px_rgba(163,70,42,0.35)] overflow-hidden transition duration-500 ease-out group-hover:-translate-y-2 group-hover:shadow-[0_40px_70px_-20px_rgba(163,70,42,0.45)] motion-reduce:transition-none motion-reduce:group-hover:translate-y-0">
        <div class="flex items-center gap-2 border-b border-black/5 bg-[#F4F6F5] px-4 py-3">
          <span class="h-3 w-3 rounded-full bg-[#E26D5C]"></span>
          <span class="h-3 w-3 rounded-full bg-accent"></span>
          <span class="h-3 w-3 rounded-full bg-[#6BAF7B]"></span>
          <span class="ml-3 flex-1 rounded-md bg-white px-3 py-1 text-xs text-muted">tischlerei-beispiel.at</span>
        </div>

        <div class="p-6">
          <div class="flex items-center justify-between">
            <span class="font-display font-bold text-ink">Tischlerei Beispiel</span>
            <div class="hidden sm:flex gap-3">
              <span class="h-2 w-10 rounded bg-black/10"></span>
              <span class="h-2 w-10 rounded bg-black/10"></span>
              <span class="h-2 w-10 rounded bg-black/10"></span>
            </div>
          </div>

          <div class="mt-6 rounded-xl bg-[#C9A27A] h-36 md:h-44 flex items-end p-5">
            <span class="font-display text-xl md:text-2xl font-bold text-white leading-tight">Möbel nach Maß,<br />gebaut für Jahrzehnte.</span>
          </div>

          <div class="mt-5 grid grid-cols-3 gap-3">
            <div class="h-16 rounded-lg bg-[#EFE6DC]"></div>
            <div class="h-16 rounded-lg bg-[#EFE6DC]"></div>
            <div class="h-16 rounded-lg bg-[#EFE6DC]"></div>
          </div>
        </div>
      </div>

      <!-- Eine Anfrage kommt rein (Teil der Eröffnungsanimation) -->
      <div class="intro-anfrage absolute -bottom-6 -left-4 md:-left-10 flex items-center gap-3 rounded-xl bg-white px-4 py-3 shadow-lg border border-black/5">
        <span class="grid h-9 w-9 place-items-center rounded-full bg-accent/20 text-accent-dark font-bold">✓</span>
        <div>
          <p class="text-sm font-medium text-ink">Neue Anfrage erhalten</p>
          <p class="text-xs text-muted">über das Kontaktformular</p>
        </div>
      </div>
    </div>

  </div>
</section>
