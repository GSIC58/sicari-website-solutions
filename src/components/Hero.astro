---
const vorteile = [
  "Festpreis ab 490 €",
  "Online in 2 bis 4 Wochen",
  "Persönlich betreut aus Vorarlberg",
];
---
<section class="relative overflow-hidden bg-cream">
  <div class="max-w-6xl mx-auto px-6 pt-16 pb-20 md:pt-24 md:pb-28 grid gap-14 md:grid-cols-[1.05fr_1fr] items-center">

    <div>
      <h1 class="font-display text-4xl md:text-6xl font-bold leading-[1.05] tracking-tight text-ink">
        Ihr Betrieb verdient eine Website, die man gern besucht.
      </h1>
      <p class="mt-6 text-lg text-muted max-w-[34rem] leading-relaxed">
        Ich baue schnelle, moderne Websites für kleine Betriebe. Zum Festpreis,
        ohne Fachchinesisch und mit einer Ansprechperson von Anfang bis Ende.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#kontakt"
           class="rounded-full bg-primary px-6 py-3 font-medium text-white hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
          Projekt anfragen
        </a>
        <a href="#angebot"
           class="rounded-full border border-primary/30 px-6 py-3 font-medium text-primary hover:border-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
          Pakete ansehen
        </a>
      </div>

      <ul class="mt-10 space-y-2 text-ink">
        {vorteile.map((v) => (
          <li class="flex items-center gap-3">
            <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
            {v}
          </li>
        ))}
      </ul>
    </div>

    <!-- Browser-Mockup einer Beispiel-Kundenseite -->
    <div class="relative" aria-hidden="true">
      <div class="absolute -inset-6 md:-inset-10 rounded-[2.5rem] bg-primary/[0.06]"></div>

      <div class="relative rounded-2xl border border-black/10 bg-white shadow-[0_30px_60px_-20px_rgba(142,42,54,0.35)] overflow-hidden">
        <div class="flex items-center gap-2 border-b border-black/5 bg-[#F4F6F5] px-4 py-3">
          <span class="h-3 w-3 rounded-full bg-[#E26D5C]"></span>
          <span class="h-3 w-3 rounded-full bg-accent"></span>
          <span class="h-3 w-3 rounded-full bg-[#6BAF7B]"></span>
          <span class="ml-3 flex-1 rounded-md bg-white px-3 py-1 text-xs text-muted">tischlerei-beispiel.at</span>
        </div>

        <div class="p-6">
          <div class="flex items-center justify-between">
            <span class="font-display font-bold text-ink">Tischlerei Beispiel</span>
            <div class="flex gap-3">
              <span class="h-2 w-10 rounded bg-black/10"></span>
              <span class="h-2 w-10 rounded bg-black/10"></span>
              <span class="h-2 w-10 rounded bg-black/10"></span>
            </div>
          </div>

          <div class="mt-6 rounded-xl bg-[#C9A27A] h-36 md:h-44 flex items-end p-5">
            <span class="font-display text-xl md:text-2xl font-bold text-white leading-tight">Möbel nach Maß,<br />gebaut für Jahrzehnte.</span>
          </div>

          <div class="mt-5 grid grid-cols-3 gap-3">
            <div class="h-16 rounded-lg bg-[#EFE6DC]"></div>
            <div class="h-16 rounded-lg bg-[#EFE6DC]"></div>
            <div class="h-16 rounded-lg bg-[#EFE6DC]"></div>
          </div>
        </div>
      </div>

      <!-- Der eine animierte Moment: eine Anfrage kommt rein -->
      <div class="anfrage absolute -bottom-6 -left-4 md:-left-10 flex items-center gap-3 rounded-xl bg-white px-4 py-3 shadow-lg border border-black/5">
        <span class="grid h-9 w-9 place-items-center rounded-full bg-accent/20 text-[#8A5F0F] font-bold">✓</span>
        <div>
          <p class="text-sm font-medium text-ink">Neue Anfrage erhalten</p>
          <p class="text-xs text-muted">über das Kontaktformular</p>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .anfrage {
    animation: reinkommen 0.7s ease-out 0.8s both;
  }
  @keyframes reinkommen {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .anfrage { animation: none; }
  }
</style>