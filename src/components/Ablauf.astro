---
import Pfeil from "./Pfeil.astro";
const schritte = [
  {
    zeit: "Tag 1",
    titel: "Kennenlernen",
    text: "Wir sprechen am Telefon oder bei Ihnen vor Ort. Danach bekommen Sie ein Angebot mit Festpreis.",
  },
  {
    zeit: "Woche 1",
    titel: "Entwurf",
    text: "Sie sehen einen ersten Entwurf und sagen mir, was passt und was nicht.",
  },
  {
    zeit: "Woche 2–3",
    titel: "Umsetzung",
    text: "Ich baue die Website mit Ihren Fotos und Texten. Je nach Paket haben Sie 1 bis 3 Korrekturrunden.",
  },
  {
    zeit: "Nach 2–4 Wochen",
    titel: "Online",
    text: "Ihre Website geht online. Für Fragen bin ich auch danach erreichbar.",
  },
];
const letzter = schritte.length - 1;
---
<section id="ablauf" class="bg-white py-20 md:py-28">
  <div class="max-w-page mx-auto px-6 lg:px-10">
    <div class="einblenden max-w-3xl">
      <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight text-ink">
        So wenig Arbeit haben Sie damit
      </h2>
      <p class="mt-4 text-lg text-muted leading-relaxed">
        Sie brauchen kein Technikwissen. Ihr Teil: ein Gespräch, Fotos und Infos zu
        Ihrem Betrieb, Ihre Rückmeldung zum Entwurf.
      </p>
    </div>

    <ol class="einblenden mt-12 grid gap-10 lg:grid-cols-4 lg:gap-8">
      {schritte.map((s, i) => (
        <li class="group relative pl-14 lg:pl-0 lg:pt-16">
          {i < letzter && (
            <span
              class="absolute left-5 top-12 -bottom-8 w-px bg-primary/20 lg:left-12 lg:-right-6 lg:top-5 lg:bottom-auto lg:h-px lg:w-auto"
              aria-hidden="true"
            ></span>
          )}
          <span
            class="absolute left-0 top-0 grid h-10 w-10 place-items-center rounded-full bg-primary font-display font-bold text-white ring-0 ring-accent/40 transition duration-300 ease-out group-hover:scale-110 group-hover:ring-4 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
            aria-hidden="true"
          >
            {i + 1}
          </span>

          <p class="text-sm font-medium text-accent-dark">{s.zeit}</p>
          <h3 class="mt-1 font-display text-xl font-bold text-ink transition-colors duration-300 group-hover:text-primary">{s.titel}</h3>
          <p class="mt-2 text-muted leading-relaxed">{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="einblenden mt-14 flex flex-col gap-4 rounded-2xl bg-cream p-7 ring-1 ring-ink/10 sm:flex-row sm:items-center sm:justify-between md:p-8">
      <p class="text-ink">
        <span class="font-display text-lg font-bold">Schritt 1 kostet nichts.</span>
        <span class="block text-muted">Ein Gespräch, ohne Verpflichtung.</span>
      </p>
      <a
        href="#kontakt"
        class="btn btn-primary flex-none"
      >
        Erstgespräch anfragen
        <Pfeil />
      </a>
    </div>
  </div>
</section>
