---
import { Image } from "astro:assets";
import { kontakt, telefonLink, whatsappLink, offeneFelder } from "../data/kontakt";
import { pakete } from "../data/pakete";
import { foto, initialen } from "../data/foto";

const formBereit = Boolean(kontakt.formAction);
const feld =
  "mt-1.5 block w-full rounded-lg border border-ink/15 bg-white px-4 py-3 text-ink transition-colors hover:border-ink/30 placeholder:text-muted/70 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20";
---
<section id="kontakt" class="bg-white py-20 md:py-28">
  <div class="max-w-page mx-auto px-6 lg:px-10">
    {import.meta.env.DEV && offeneFelder.length > 0 && (
      <p class="mb-10 rounded-lg border border-accent bg-accent/15 px-4 py-3 text-sm text-ink">
        <strong>Nur im Dev-Server sichtbar:</strong> In <code>src/data/kontakt.ts</code> fehlen noch:{" "}
        {offeneFelder.join(", ")}
      </p>
    )}

    <div class="einblenden grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <div>
        <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight text-ink">
          Erzählen Sie mir von Ihrem Betrieb
        </h2>
        <p class="mt-4 text-lg text-muted leading-relaxed">
          Ein paar Zeilen reichen. Ich melde mich
          {kontakt.antwortzeit ? ` ${kontakt.antwortzeit}` : " so bald wie möglich"} persönlich zurück.
        </p>

        <div class="mt-8 flex items-center gap-4">
          {foto ? (
            <Image src={foto} alt={`Foto von ${kontakt.name}`} width={128} height={128} class="h-16 w-16 rounded-full object-cover" />
          ) : (
            <span class="grid h-16 w-16 flex-none place-items-center rounded-full bg-primary font-display text-xl font-bold text-white" aria-hidden="true">
              {initialen}
            </span>
          )}
          <div>
            <p class="font-display text-lg font-bold text-ink">{kontakt.name}</p>
            <p class="text-sm text-muted">Ihre Ansprechperson – vom ersten Gespräch bis nach dem Livegang</p>
          </div>
        </div>

        <ul class="mt-8 space-y-4 text-ink">
          <li class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 flex-none text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
            <div>
              <a href={telefonLink} class="font-medium hover:text-primary transition-colors">{kontakt.telefon}</a>
              <p class="text-sm text-muted">{kontakt.erreichbarkeit}</p>
            </div>
          </li>
          <li class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 flex-none text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            <a href={`mailto:${kontakt.email}`} class="font-medium break-all hover:text-primary transition-colors">{kontakt.email}</a>
          </li>
          <li class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 flex-none text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <div>
              <p class="font-medium">{kontakt.region}</p>
              {kontakt.vorOrt && <p class="text-sm text-muted">Gerne komme ich auch bei Ihnen vorbei.</p>}
            </div>
          </li>
        </ul>

        {(kontakt.whatsapp || kontakt.terminLink) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {kontakt.whatsapp && (
              <a
                href={whatsappLink}
                target="_blank"
                rel="noopener"
                class="btn btn-secondary"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                Per WhatsApp schreiben
              </a>
            )}
            {kontakt.terminLink && (
              <a
                href={kontakt.terminLink}
                target="_blank"
                rel="noopener"
                class="btn btn-secondary"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                Termin buchen
              </a>
            )}
          </div>
        )}
      </div>

      <form
        method="POST"
        action={kontakt.formAction || undefined}
        class="rounded-2xl bg-cream p-7 ring-1 ring-ink/10 md:p-8"
      >
        {Object.entries(kontakt.formFelder).map(([name, wert]) => (
          <input type="hidden" name={name} value={wert} />
        ))}
        <!-- Spam-Falle: für Menschen unsichtbar, Bots füllen sie aus -->
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block text-sm font-medium text-ink">
            Name <span class="text-primary" aria-hidden="true">*</span>
            <input type="text" name="name" required autocomplete="name" class={feld} />
          </label>
          <label class="block text-sm font-medium text-ink">
            Betrieb <span class="font-normal text-muted">(optional)</span>
            <input type="text" name="betrieb" autocomplete="organization" class={feld} />
          </label>
          <label class="block text-sm font-medium text-ink">
            E-Mail <span class="text-primary" aria-hidden="true">*</span>
            <input type="email" name="email" required autocomplete="email" class={feld} />
          </label>
          <label class="block text-sm font-medium text-ink">
            Telefon <span class="font-normal text-muted">(optional)</span>
            <input type="tel" name="telefon" autocomplete="tel" class={feld} />
          </label>
          <label class="block text-sm font-medium text-ink sm:col-span-2">
            Welches Paket interessiert Sie?
            <select id="paket" name="paket" class={feld}>
              <option>Noch unsicher</option>
              {pakete.map((p) => <option value={p.name}>{p.name} (ab {p.preis})</option>)}
            </select>
          </label>
          <label class="block text-sm font-medium text-ink sm:col-span-2">
            Ihre Nachricht <span class="text-primary" aria-hidden="true">*</span>
            <textarea
              name="nachricht"
              required
              rows="5"
              placeholder="Was macht Ihr Betrieb, und was soll die Website können?"
              class={feld}
            ></textarea>
          </label>
        </div>

        <p class="mt-5 text-xs text-muted leading-relaxed">
          Mit * markierte Felder sind Pflichtfelder. Ihre Angaben verwende ich nur, um Ihre Anfrage
          zu beantworten. Mehr dazu in der <a href="/datenschutz" class="underline hover:text-primary">Datenschutzerklärung</a>.
        </p>

        <button
          type="submit"
          disabled={!formBereit}
          class="btn btn-primary mt-6 w-full disabled:cursor-not-allowed disabled:opacity-50 disabled:active:scale-100 sm:w-auto"
        >
          Anfrage senden
        </button>
        {!formBereit && (
          <p class="mt-3 text-sm text-muted">
            Das Formular ist noch nicht aktiv. Bitte schreiben Sie mir so lange direkt per E-Mail oder rufen Sie an.
          </p>
        )}
      </form>
    </div>
  </div>
</section>

<script>
  // Klick auf „Erstgespräch anfragen“ in einer Preiskarte wählt das Paket im Formular vor
  const auswahl = document.getElementById("paket") as HTMLSelectElement;
  document.querySelectorAll<HTMLElement>("[data-paket]").forEach((link) => {
    link.addEventListener("click", () => {
      auswahl.value = link.dataset.paket ?? "";
    });
  });
</script>
