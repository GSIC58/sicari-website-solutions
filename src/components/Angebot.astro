---
import { pakete } from "../data/pakete";
import Pfeil from "./Pfeil.astro";
---
<section id="angebot" class="bg-white py-20 md:py-28">
  <div class="max-w-page mx-auto px-6 lg:px-10">
    <div class="einblenden max-w-3xl">
      <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight text-ink">
        Was Ihre Website kostet
      </h2>
      <p class="mt-4 text-lg text-muted leading-relaxed">
        Drei Pakete, je nachdem, wie viel Sie zeigen wollen. Welches passt,
        klären wir im Erstgespräch.
      </p>
    </div>

    <div class="einblenden mt-12 grid gap-6 lg:grid-cols-3">
      {pakete.map((p) => (
        <article
          class:list={[
            "karte-hover group relative flex flex-col rounded-2xl p-7 md:p-8",
            p.empfehlung ? "bg-cream ring-2 ring-primary" : "bg-cream/60 ring-1 ring-ink/10 hover:bg-cream hover:ring-primary/40 focus-within:bg-cream focus-within:ring-primary/40",
          ]}
        >
          {p.empfehlung && (
            <span class="absolute -top-3 left-7 rounded-full bg-accent px-3 py-1 text-xs font-semibold text-ink">
              Meine Empfehlung
            </span>
          )}

          <h3 class="font-display text-xl font-bold text-ink">{p.name}</h3>
          <p class="mt-1 text-sm text-muted">{p.fuer}</p>

          <p class="mt-6 text-ink">
            <span class="mr-1 text-sm">ab</span>
            <span class="font-display text-4xl font-bold tracking-tight transition-colors duration-300 group-hover:text-primary">{p.preis}</span>
          </p>

          <ul class="mt-6 mb-8 space-y-3 text-ink">
            {p.leistungen.map((l) => (
              <li class="flex gap-3">
                <svg class="mt-0.5 h-5 w-5 flex-none text-primary" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 10.5l4 4 8-9" />
                </svg>
                {l}
              </li>
            ))}
          </ul>

          <a
            href="#kontakt"
            data-paket={p.name}
            class:list={[
              "btn mt-auto",
              p.empfehlung
                ? "btn-primary"
                : "btn-secondary group-hover:border-primary group-hover:bg-primary group-hover:text-white",
            ]}
          >
            Erstgespräch anfragen<span class="sr-only"> (Paket {p.name})</span>
            <Pfeil />
          </a>
        </article>
      ))}
    </div>

    <p class="mt-10 text-sm text-muted">
      Unsicher, welches Paket passt? Das klären wir im Erstgespräch.
    </p>
  </div>
</section>
